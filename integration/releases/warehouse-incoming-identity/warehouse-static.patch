@@ -10,0 +11,26 @@ let staffConfirmed=false;
+const receivingReadMessages = {
+ SIGN_IN_REQUIRED: ['Sign in required 请登录', 'Sign in with your LTPOS work account to read incoming orders. 请使用 LTPOS 工作账号登入后读取收货订单。'],
+ STAFF_UNVERIFIED: ['Staff identity not verified 员工身份未确认', 'Use your verified work email or ask your administrator to confirm your staff record. 请使用已验证的工作邮箱，或联系管理员核对员工资料。'],
+ ACCESS_DENIED: ['Warehouse access unavailable 无收货查看权限', 'This account cannot read incoming orders for the selected company. Check your Warehouse permission for this company. 此账号无法读取所选公司的收货订单，请核对该公司的仓库查看权限。'],
+ READ_UNAVAILABLE: ['Receiving data unavailable 收货资料待连接', 'Incoming orders could not be read. Retry to reconnect. 收货订单暂时无法读取，请重试。']
+};
+function showReceivingReadError(message){
+ const error = String(message.error || '');
+ // During the rollout, an older Wix page may still send the legacy reply.
+ const legacyStates = {
+  'Please sign in with your approved Master staff account.':'SIGN_IN_REQUIRED',
+  'Sign in with your approved staff account.':'SIGN_IN_REQUIRED',
+  'Sign in with your verified Google work email.':'STAFF_UNVERIFIED',
+  'Staff identity changed. Sign in again.':'STAFF_UNVERIFIED',
+  'Staff access is not authorized.':'STAFF_UNVERIFIED',
+  'Staff permission does not allow this operation.':'ACCESS_DENIED'
+ };
+ const status = Object.hasOwn(receivingReadMessages, message.readStatus)
+  ? message.readStatus : (Object.hasOwn(legacyStates, error) ? legacyStates[error] : 'READ_UNAVAILABLE');
+ const [staffLabel, explanation] = receivingReadMessages[status];
+ $('login').hidden = status !== 'SIGN_IN_REQUIRED';
+ $('refresh').hidden = status !== 'READ_UNAVAILABLE';
+ if (status !== 'READ_UNAVAILABLE') staffConfirmed = false;
+ if (!staffConfirmed) $('staff').textContent = staffLabel;
+ notice(explanation, true);
+}
