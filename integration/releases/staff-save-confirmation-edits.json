          "  .customer-access label{font-weight:400}",
          "  .editor-empty{padding:18px;color:#4e6680}",
          "  #save-status{flex:1}",
          "  #save[hidden]{display:none}",
          "  @media(max-width:800px){body>header{padding:0 12px;gap:10px;font-size:12px}body>header strong{font-size:16px}body>header span{padding-left:10px}}",
          "  @media(max-width:760px){.workspace{grid-template-columns:1fr}}",
          "  @media(max-width:540px){main{padding:16px 12px}h1{font-size:22px}.heading{gap:8px}}",
          "</style>",
          "<header><strong>MASTER</strong><span>Administration 管理</span></header>",
          "<main>",
          "  <div class=\"heading\"><h1>Staff Management 员工管理</h1><button id=\"add\" class=\"primary\" type=\"button\" disabled>＋ Add Employee</button></div>",
          "  <div class=\"workspace\">",
          "  <section class=\"panel\" aria-label=\"Staff directory\">",
          "    <div class=\"toolbar\"><input type=\"search\" id=\"search\" aria-label=\"Find staff\" placeholder=\"Search name or work email\"></div>",
          "    <ul id=\"employees\"></ul>",
          "    <footer><output id=\"status\" aria-live=\"polite\">Opening MASTER staff directory…</output><button id=\"sign-in\" class=\"primary\" hidden>Sign in 登录</button></footer>",
          "    <output id=\"directory-warning\" class=\"editor-empty error\" aria-live=\"polite\" hidden></output>",
          "  </section>",
          "<section class=\"panel editor\" aria-labelledby=\"add-title\">",
          "    <h2 id=\"add-title\">Employee access 员工权限</h2>",
          "    <p id=\"editor-empty\" class=\"editor-empty\">Select an employee to view their access.</p>",
          "  <form id=\"add-form\" hidden>",
          "    <section>",
          "      <label>Employee name<input name=\"name\" maxlength=\"80\" required></label>",
          "      <label>Work Email<input name=\"email\" type=\"email\" maxlength=\"254\" autocapitalize=\"none\" spellcheck=\"false\" required></label>",
          "      <label id=\"employee-status\" hidden>Status<select name=\"status\"><option value=\"PENDING\">Pending</option><option value=\"ACTIVE\">Active</option><option value=\"DISABLED\">Disabled</option></select></label>",
          "      <p id=\"registration-help\" hidden>Use the employee’s Google work email. No invitation is needed.</p>",
          "      <details class=\"access-options\">",
          "      <summary>Set access now (optional)</summary>",
          "      <fieldset>",
          "        <legend>Companies 公司</legend>",
          "        <div class=\"scope-grid\">",
          "          <label class=\"check\"><input type=\"checkbox\" name=\"company\" value=\"NCT\">NCT</label>",
          "          <label class=\"check\"><input type=\"checkbox\" name=\"company\" value=\"GHR\">GHR</label>",
          "        </div>",
          "      </fieldset>",
          "      <fieldset>",
          "        <legend>Department access 部门权限</legend>",
          "        <div id=\"department-options\" class=\"scope-grid\"></div>",
          "        <label class=\"check\"><input type=\"checkbox\" name=\"supportViewAll\">Support can view all customers</label>",
          "      </fieldset>",
          "      <fieldset>",
          "        <legend>Sales Room</legend>",
          "        <div class=\"scope-grid\">",
          "          <label>Function<select name=\"salesFunction\"><option value=\"\">None</option><option>SALES</option><option>SUPPORT</option></select></label>",
          "          <label>Access<select name=\"salesRoom\"><option value=\"\">None</option><option value=\"VIEW\">View</option><option value=\"EDIT\">Edit</option></select></label>",
          "        </div>",
          "      </fieldset>",
          "      <fieldset>",
          "        <legend>Customer access 客户权限</legend>",
          "        <p>View permits browsing. Edit permits customer work; Support cannot edit or publish quotations.</p>",
          "        <div id=\"customer-options\"></div>",
          "        <output id=\"customer-status\" aria-live=\"polite\"></output>",
          "      </fieldset>",
          "      </details>",
          "    </section>",
          "    <footer><output id=\"save-status\" aria-live=\"polite\" hidden></output><button id=\"cancel\" type=\"button\">Cancel</button><button id=\"save\" class=\"primary\">Add Employee</button></footer>",
          "  </form>",
          "</section>",
          "  </div>",
          "</main>",
          "<script type=\"module\">",
          "  const id = name => document.getElementById(name);",
          "  const parentOrigin = 'https://fmcg999.wixstudio.com';",
          "  const requests = new Map();",
          "  const employees = [];",
          "  let editing = null, pendingSave = null, customers = [], selected = null;",
          "  let dirty = false, saving = false;",
          "  let customerLoad = 0;",
          "",
          "  function send(action, fields = {}) {",
          "    if (window.parent === window) return Promise.reject(Error('Open this page from the MASTER website.'));",
          "    return new Promise((resolve, reject) => {",
          "      const requestId = crypto.randomUUID();",
          "      const timer = setTimeout(() => {",
          "        requests.delete(requestId);",
          "        reject(Error('MASTER did not confirm the request. Reload the directory to check its status.'));",
          "      }, 15000);",
          "      requests.set(requestId, { resolve, reject, timer });",
          "      window.parent.postMessage({ action, requestId, ...fields }, parentOrigin);",
          "    });",
          "  }",
          "",
          "  window.addEventListener('message', event => {",
          "    if (event.origin !== parentOrigin || event.source !== window.parent || event.data?.type !== 'MASTER_STAFF_RESULT') return;",
          "    const request = requests.get(event.data.requestId);",
          "    if (!request) return;",
          "    requests.delete(event.data.requestId);",
          "    clearTimeout(request.timer);",
          "    if (event.data.ok) request.resolve(event.data);",
          "    else if (event.data.signInRequired) {",
          "      const error = Error('Sign in with your MASTER staff account.');",
          "      error.signInRequired = true;",
          "      request.reject(error);",
          "    } else request.reject(Error(event.data.error || 'The request was rejected.'));",
          "  });",
          "",
          "  function render() {",
          "    const term = id('search').value.trim().toLowerCase();",
          "    const visible = employees.filter(employee => [employee.name, employee.email].some(value => value.toLowerCase().includes(term)));",
          "    const rows = visible.map(employee => {",
          "      const row = document.createElement('li');",
          "      const button = document.createElement('button');",
          "      button.type = 'button';",
          "      button.className = 'employee-link';",
          "      if (selected?.staffId === employee.staffId) button.setAttribute('aria-current', 'true');",
          "      const name = document.createElement('span');",
          "      name.className = 'employee-name';",
          "      name.textContent = employee.name;",
          "      const status = document.createElement('span');",
          "      status.className = 'employee-status';",
          "      status.textContent = employee.role === 'SUPER ADMIN' ? 'Super Admin' :",
          "        employee.status === 'PENDING' ? 'Pending verification' : employee.status;",
          "      name.append(status);",
          "      const email = document.createElement('span');",
          "      email.className = 'employee-email';",
          "      email.textContent = employee.email;",
          "      button.append(name, email);",
          "      button.addEventListener('click', () => selectEmployee(employee));",
          "      row.append(button);",
          "      return row;",
          "    });",
          "    id('employees').replaceChildren(...rows);",
          "    id('status').textContent = visible.length + (visible.length === 1 ? ' employee' : ' employees');",
          "  }",
          "",
          "  const form = id('add-form');",
          "  const departments = [",
          "    ['PURCHASE', 'Purchase'], ['SUPPORT', 'Support'], ['WAREHOUSE', 'Warehouse'],",
          "    ['ACCOUNT', 'Finance'], ['SALES MANAGEMENT', 'Sales Management']",
          "  ];",
          "  for (const [department, labelText] of departments) {",
          "    const label = document.createElement('label');",
          "    label.textContent = labelText;",
          "    const select = document.createElement('select');",
          "    select.name = department;",
          "    select.add(new Option('None', ''));",
          "    select.add(new Option('View', 'VIEW'));",
          "    select.add(new Option('Edit', 'EDIT'));",
          "    label.append(select);",
          "    id('department-options').append(label);",
          "  }",
          "  function registration() {",
          "    const data = new FormData(form);",
          "    return {",
          "      name: data.get('name'),",
          "      email: data.get('email'),",
          "      access: {",
          "        departmentAccess: Object.fromEntries(departments.map(([department]) =>",
          "          [department, data.get(department)]).filter(([, level]) => level)),",
          "        companyIds: data.getAll('company'),",
          "        supportViewAll: data.has('supportViewAll'),",
          "        salesRoom: data.get('salesRoom'),",
          "        salesFunction: data.get('salesFunction'),",
          "        customerAccess: Object.fromEntries([...id('customer-options').querySelectorAll('select')]",
          "          .filter(select=>select.value).map(select=>[select.dataset.customerId,select.value]))",
          "      }",
          "    };",
          "  }",
          "  id('search').addEventListener('input', render);",
          "  function renderCustomerAccess(access) {",
          "    const known = new Map(customers.map(customer=>[customer.id,customer.name]));",
          "    for (const customerId of Object.keys(access ?? {})) if (!known.has(customerId)) known.set(customerId,customerId);",
          "    id('customer-options').replaceChildren(...[...known].map(([customerId,name],index)=>{",
          "      const row=document.createElement('div'); row.className='customer-access';",
          "      const label=document.createElement('label'); label.textContent=name; label.htmlFor='grant-'+index;",
          "      const select=document.createElement('select'); select.id=label.htmlFor; select.dataset.customerId=customerId;",
          "      select.add(new Option('No access',''));select.add(new Option('View','VIEW'));select.add(new Option('Edit','EDIT'));",
          "      select.value=access?.[customerId] ?? '';row.append(label,select);return row;",
          "    }));",
          "  }",
          "  function showSaveStatus(message, isError = false) {",
          "    const output = id('save-status');",
          "    output.hidden = !message;",
          "    output.className = isError ? 'error' : '';",
          "    output.textContent = message;",
          "  }",
          "",
          "  function selectEmployee(employee = null) {",
          "    if (saving || pendingSave) return;",
          "    if (!form.hidden && selected === employee) return;",
          "    if (dirty) {",
          "      showSaveStatus('Save or cancel your changes before switching employees.', true);",
          "      return;",
          "    }",
          "    void openEmployee(employee);",
          "  }",
          "",
          "  async function openEmployee(employee = null, saved = false) {",
          "    const load = ++customerLoad;",
          "    selected = employee;",
          "    editing = employee;",
          "    dirty = false;",
          "    pendingSave = null;",
          "    form.reset();",
          "    id('add-title').textContent = employee?.name ?? 'Add Employee';",
          "    const administrator = employee?.role === 'SUPER ADMIN';",
          "    form.hidden = administrator;",
          "    id('editor-empty').hidden = !administrator;",
          "    render();",
          "    if (administrator) {",
          "      id('editor-empty').textContent = 'Super Admin · ' + employee.email;",
          "      return;",
          "    }",
          "    form.querySelectorAll('input,select').forEach(element=>element.disabled=false);",
          "    id('save').textContent=employee?'Save':'Add Employee';",
          "    id('employee-status').hidden=!employee;",
          "    id('registration-help').hidden = Boolean(employee);",
          "    showSaveStatus(saved ? 'Saved successfully 已保存' : '');",
          "    id('save').hidden = saved;",
          "    id('cancel').textContent = saved ? 'Done' : 'Cancel';",
          "    const access=employee?.access ?? {};",
          "    form.elements.namedItem('name').value=employee?.name ?? '';",
          "    form.elements.namedItem('email').value=employee?.email ?? '';",
          "    form.elements.namedItem('status').value=employee?.status ?? 'PENDING';",
          "    for(const [department] of departments) form.elements.namedItem(department).value=access.departmentAccess?.[department] ?? '';",
          "    form.querySelectorAll('[name=company]').forEach(box=>box.checked=access.companyIds?.includes(box.value)===true);",
          "    form.elements.namedItem('supportViewAll').checked=access.supportViewAll===true;",
          "    form.elements.namedItem('salesRoom').value=access.salesRoom ?? '';",
          "    form.elements.namedItem('salesFunction').value=access.salesFunction ?? '';",
          "    form.querySelector('details').open = Boolean(employee);",
          "    if (saved) {",
          "      renderCustomerAccess(access.customerAccess);",
          "      id('customer-status').textContent = '';",
          "      id('save').disabled = false;",
          "      return;",
          "    }",
          "    id('customer-options').replaceChildren();",
          "    id('save').disabled=true;id('customer-status').textContent='Loading customers…';",
          "    try{",
          "      const result=await send('LIST_CUSTOMERS');",
          "      if (form.hidden || load !== customerLoad) return;",
          "      customers=result.customers;",
          "      renderCustomerAccess(access.customerAccess);id('customer-status').textContent='';id('save').disabled=false;",
          "    }catch(error){if (!form.hidden && load === customerLoad) id('customer-status').textContent=error.message;}",
          "  }",
          "  id('add').addEventListener('click', () => selectEmployee());",
          "  id('cancel').addEventListener('click', () => {",
          "    if (saving || pendingSave) return;",
          "    if (editing && !id('save').hidden) { void openEmployee(editing); return; }",
          "    customerLoad++;",
          "    dirty = false;",
          "    selected = editing = null;",
          "    form.hidden = true;",
          "    id('add-title').textContent = 'Employee access 员工权限';",
          "    id('editor-empty').textContent = 'Select an employee to view their access.';",
          "    id('editor-empty').hidden = false;",
          "    render();",
          "  });",
          "  form.addEventListener('input', () => {",
          "    dirty = true;",
          "    id('save').hidden = false;",
          "    id('cancel').textContent = 'Cancel';",
          "    showSaveStatus('');",
          "  });",
          "  form.addEventListener('submit', async event => {",
          "    event.preventDefault();",
          "    if (form.hidden || saving || id('save').disabled || id('save').hidden) return;",
          "    const submittedWithSaveFocus = document.activeElement === id('save');",
          "    saving = true;",
          "    id('save').disabled = true;",
          "    id('cancel').disabled = true;",
          "    showSaveStatus('Saving…');",
          "    let savedEmployee;",
          "    try {",
          "      if(!pendingSave) pendingSave={...registration(),saveRequestId:crypto.randomUUID(),",
          "        ...(editing?{staffId:editing.staffId,revision:editing.revision,status:form.elements.namedItem('status').value}:{})};",
          "      form.querySelectorAll('input,select').forEach(element => element.disabled = true);",
          "      const result = await send(editing?'UPDATE_STAFF':'REGISTER_STAFF', pendingSave);",
          "      const index=employees.findIndex(employee=>employee.staffId===result.employee.staffId);",
          "      if(index>=0)employees[index]=result.employee;else employees.push(result.employee);",
          "      savedEmployee = result.employee;",
          "    } catch (error) {",
          "      showSaveStatus(error.message, true);",
          "      const uncertain=/awaiting confirmation|did not confirm/i.test(error.message);",
          "      if(!uncertain)pendingSave=null;",
          "      form.querySelectorAll('input,select').forEach(element=>element.disabled=uncertain);",
          "      id('save').textContent=uncertain?'Check same save':editing?'Save':'Add Employee';",
          "    } finally {",
          "      saving = false;",
          "      id('save').disabled = false;",
          "      id('cancel').disabled = Boolean(pendingSave && !savedEmployee);",
          "    }",
          "    if (savedEmployee) {",
          "      void openEmployee(savedEmployee, true);",
          "      if (submittedWithSaveFocus && document.activeElement === document.body && !form.hidden) id('cancel').focus();",
          "    }"
        ]
      }
    ]
  }
}
