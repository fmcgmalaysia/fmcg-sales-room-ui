
#app .purchase-tasks.active-order-table .waiting-row .borrow-source-action{display:inline-flex;vertical-align:middle;align-items:center;justify-content:center;width:27px;height:26px;margin-inline-start:8px;padding:0;border:0;border-radius:4px;background:transparent;color:#F58A00;cursor:pointer}#app .purchase-tasks.active-order-table .waiting-row .borrow-source-action:hover,#app .purchase-tasks.active-order-table .waiting-row .borrow-source-action:focus-visible{background:#fff1dd}#app .purchase-tasks.active-order-table .waiting-row .borrow-source-action .stock-source-icon{background:currentColor}
