{
  "jobs": [
    {
      "functionLocation": "/catalogueProtectionRuntime.js",
      "functionName": "processCatalogueSecurityNotifications",
      "description": "Retry pending owner notifications for catalogue protection.",
      "executionConfig": { "cronExpression": "17 * * * *" }
    },
    {
      "functionLocation": "/cataloguePhotoMigrationAdmin.web.js",
      "functionName": "processCatalogueMigrationWindow",
      "description": "Resume private catalogue image migration until 7 a.m. MYT.",
      "executionConfig": { "cronExpression": "5 16-22 26 11 *" }
    }
  ]
}
